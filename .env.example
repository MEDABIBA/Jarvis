JARVIS_SANDBOX=sandbox/

# models
JARVIS_ANTHROPIC_API_KEY = "your-api-key-here"
JARVIS_GEMINI_API_KEY = "your-api-key-here"
JARVIS_GPT_API_KEY = "your-api-key-here"
JARVIS_CEREBRAS_API_KEY = "your-api-key-here"

JARVIS_LOCAL_MODEL="Your local LLM e.g. mistral"

JARVIS_ANTHROPIC_MODEL="Your anthropic LLM e.g. claude-sonnet-5"
JARVIS_GEMINI_MODEL="Your gemini LLM e.g. gemini-3.8-flash"
JARVIS_GPT_MODEL="Your gpt LLM e.g. gpt-4"
JARVIS_CEREBRAS_MODEL="Your cerebras LLM e.g. gpt-oss-120b"

# piper and text never use cloud speech. Press F3 to enable speech output.
JARVIS_SPEECH__PROVIDER=piper
JARVIS_SPEECH__LOCALE=en-GB
JARVIS_VOICES_DIR=./voices

# To use Azure, select azure_sdk (uv run --extra azure jarvis) or azure_rest.
JARVIS_SPEECH__AZURE_KEY=
JARVIS_SPEECH__AZURE_REGION=westeurope

# JSON voice maps replace the defaults; see docs/SPEECH.md.
# JARVIS_SPEECH__AZURE_VOICES='{"pl-PL":"pl-PL-MarekNeural"}'
# JARVIS_SPEECH__PIPER_VOICES='{"pl-PL":"PL/pl_PL-mc_speech-medium.onnx"}'
